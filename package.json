{
  "name": "dao-den-long",
  "version": "0.1.0",
  "description": "Đảo Đèn Lồng - game 3D (three.js) với chế độ headless theo Test Contract v1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/sim.test.js tests/headless.test.js tests/leaderboard.test.js",
    "bench": "node scripts/bench.js --seed 42 --duration 30 --out bench.json",
    "soak": "node --expose-gc --jitless scripts/soak.js --seed 7 --nights 10 --out soak.json",
    "headless": "node src/headless.js",
    "proof": "node scripts/proof.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "license": "MIT"
}
